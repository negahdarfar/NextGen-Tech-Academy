# Cloud language-model fallback order. FreeLLMAPI is optional and uses only explicitly free models.
LLM_PROVIDER_ORDER=freellmapi,omniroute,gemini,groq,openrouter
# Optional unattended cloud gateway (not the phone/Tailscale gateway).
# FREELLMAPI_CLOUD_BASE_URL=
# FREELLMAPI_CLOUD_API_KEY=
FREELLMAPI_MODEL=auto
# Optional local/remote OpenAI-compatible OmniRoute gateway; CI creates a temporary loopback instance.
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=gemini/gemini-2.5-flash
# OMNIROUTE_API_KEY= (only if your gateway requires a client key)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ALLOW_PAID_LLM=false

# Preferred visual generator: Agnes AI Video 2.5 Flash (720p, 4-12s).
# Free access is a limited-time $0/sec promotion with rate limits; verify account quota.
# AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Free stock-footage fallback (and standalone option).
# PEXELS_API_KEY=

# Cloud TTS
TTS_VOICE=en-US-AriaNeural

# YouTube OAuth authorized-user token JSON. Store as a GitHub Secret; never commit it.
# YOUTUBE_TOKEN_JSON=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_ALLOW_PUBLIC=false
