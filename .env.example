# Application
NEXTGEN_ENV=development
NEXTGEN_LOG_LEVEL=INFO

# Optional local model provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional VidoGrid API (API usage may consume VidoGrid credits)
# Obtain an API key from your VidoGrid account; never commit the real key.
# VIDOGRID_API_KEY=
VIDOGRID_ENDPOINT=/video-gen/grok-imagine-video-1.5-lite
VIDOGRID_MODEL=grok-imagine-video-1.5-lite
VIDOGRID_DURATION_SECONDS=15 # four clips x 15 seconds = 60-second video
VIDOGRID_ASPECT_RATIO=16:9
VIDOGRID_RESOLUTION=720p

# Optional YouTube publishing credentials (publishing is not implemented)
# YOUTUBE_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
