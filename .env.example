# Cloud language-model fallback order
LLM_PROVIDER_ORDER=gemini,groq,openrouter
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ALLOW_PAID_LLM=false

# Pexels stock footage API key (free API access; required for cloud video assembly)
# PEXELS_API_KEY=

# Cloud TTS
TTS_VOICE=en-US-AriaNeural

# YouTube OAuth authorized-user token JSON. Store as a GitHub Secret; never commit it.
# YOUTUBE_TOKEN_JSON=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_ALLOW_PUBLIC=false
