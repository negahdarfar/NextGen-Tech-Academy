# Cloud language-model fallback order. Configure one or more API keys in GitHub Secrets.
LLM_PROVIDER_ORDER=gemini,groq,openrouter
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Only use a model ending in :free unless explicitly permitting paid LLM usage.
ALLOW_PAID_LLM=false

# VidoGrid API key; generation consumes VidoGrid credits.
# VIDOGRID_API_KEY=
VIDOGRID_MODEL_ROTATION=grok-imagine-video-1.5-lite,veo-3.1-fast,omni-1.2-flash
VIDOGRID_DURATION_SECONDS=15
VIDOGRID_ASPECT_RATIO=16:9
VIDOGRID_RESOLUTION=720p
# Required: separate free-credit balance must be reported by API. Set model costs only after checking your account's current pricing.
VIDOGRID_MODEL_CREDIT_COSTS=
# Set true only if you verified the entire /account balance consists solely of free credits.
VIDOGRID_TOTAL_BALANCE_IS_FREE=false
# Optional legacy single-model fallback: VIDOGRID_CREDITS_PER_CLIP=
VIDOGRID_TIMEOUT_SECONDS=2400
VIDOGRID_POLL_INTERVAL=10

# Cloud TTS
TTS_VOICE=en-US-AriaNeural

# YouTube OAuth authorized-user token JSON. Store as a GitHub Secret; never commit it.
# YOUTUBE_TOKEN_JSON=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_ALLOW_PUBLIC=false
