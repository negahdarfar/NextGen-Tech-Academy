# Cloud language-model fallback order. Configure one or more API keys in GitHub Secrets.
LLM_PROVIDER_ORDER=omniroute,gemini,groq,openrouter
# Optional local/remote OpenAI-compatible OmniRoute gateway; CI creates a temporary loopback instance.
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=gemini/gemini-2.5-flash
# OMNIROUTE_API_KEY= (only if your gateway requires a client key)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Only use a model ending in :free unless explicitly permitting paid LLM usage.
ALLOW_PAID_LLM=false

# Free Pexels stock-video API key (register for a free key; rate limits apply).
# PEXELS_API_KEY=

# Cloud TTS
TTS_VOICE=en-US-AriaNeural

# YouTube OAuth authorized-user token JSON. Store as a GitHub Secret; never commit it.
# YOUTUBE_TOKEN_JSON=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_ALLOW_PUBLIC=false
